{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["credflare"],
  "ios": {
    "iosModuleName": "CredflareFaceVision"
  },
  "android": {
    "androidNamespace": ["credflare"],
    "androidCxxLibName": "CredflareFaceVision"
  },
  "autolinking": {
    "VisionFaceDetectorFactory": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVisionFaceDetectorFactory"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "example"]
}
